# --- Local account (used when CHAOS_SSO_SECRET is empty) ---
CHAOS_LOCAL_USER=admin
CHAOS_LOCAL_PASSWORD=change-me-please-12+chars

# --- SSO handoff from the admin console (optional) ---
# HS256 secret shared with the console, >= 32 characters.
CHAOS_SSO_SECRET=
# Accepted `iss` values, comma separated.
CHAOS_SSO_ISSUERS=admin-console
# Signs Chaos's own sessions. MUST differ from CHAOS_SSO_SECRET, >= 32 chars.
CHAOS_SESSION_SECRET=
CHAOS_SESSION_TTL_S=28800
# Who may embed Chaos in an iframe (CSP frame-ancestors).
CHAOS_FRAME_ANCESTORS='self' http://127.0.0.1:3000

# Token for the demo target's /metrics probe (tokenEnv in chaos.targets.yaml).
DEMO_METRICS_TOKEN=demo-metrics-token
